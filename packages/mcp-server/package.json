{
  "name": "yungle-mcp",
  "mcpName": "co.yungle/yungle",
  "version": "0.2.1",
  "type": "module",
  "description": "MCP server for Yungle: let Claude, Cursor or any MCP client read your file transfers, share files and send them, with your approval.",
  "bin": {
    "yungle-mcp": "./dist/server.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "prepublishOnly": "node build.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.24.1",
    "yungle-client": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude",
    "cursor",
    "ai-agents",
    "file-transfer",
    "file-sharing",
    "wetransfer-alternative",
    "eu",
    "gdpr",
    "yungle"
  ],
  "license": "MIT",
  "author": "Brainpower <hello@yungle.co> (https://yungle.co)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heindewilde/yungle-clients.git"
  },
  "homepage": "https://yungle.co/developers/mcp?ref=npm",
  "bugs": {
    "url": "https://github.com/heindewilde/yungle-clients/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/index.mjs"
    }
  }
}
