{
  "name": "yungle-client",
  "version": "0.2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "prepublishOnly": "node build.mjs",
    "prepare": "node build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "esbuild": "^0.28.1"
  },
  "description": "Typed client for the Yungle API — send file transfers, build collections and sync contacts from Node.",
  "license": "MIT",
  "author": "Brainpower <hello@yungle.co> (https://yungle.co)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heindewilde/yungle-clients.git"
  },
  "homepage": "https://yungle.co/developers/reference?ref=npm",
  "bugs": {
    "url": "https://github.com/heindewilde/yungle-clients/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "yungle",
    "file-transfer",
    "file-sharing",
    "api-client",
    "sdk",
    "typescript",
    "webhooks",
    "upload",
    "wetransfer-alternative",
    "eu",
    "gdpr"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts"
}
