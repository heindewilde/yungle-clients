{
  "name": "yungle-cli",
  "version": "0.1.2",
  "type": "module",
  "description": "Send and sync files with Yungle from the command line.",
  "bin": {
    "yungle": "./dist/yungle.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "dev": "node --import tsx bin/yungle.mjs",
    "prepublishOnly": "node build.mjs"
  },
  "dependencies": {
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.1",
    "picocolors": "^1.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "yungle-client": "workspace:*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cli",
    "eu",
    "file-transfer",
    "gdpr",
    "resumable",
    "tus",
    "upload",
    "wetransfer-alternative",
    "yungle"
  ],
  "license": "MIT",
  "author": "Hein de Wilde",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heindewilde/yungle-clients.git"
  },
  "homepage": "https://yungle.co/developers",
  "bugs": {
    "url": "https://github.com/heindewilde/yungle-clients/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
