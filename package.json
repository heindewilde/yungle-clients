{
  "name": "yungle-clients",
  "private": true,
  "description": "Client libraries for the Yungle API: a CLI, an MCP server and a typed SDK.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "contract": "node scripts/contract.mjs",
    "changeset": "changeset",
    "release": "pnpm -r build && changeset publish",
    "version": "changeset version && node scripts/sync-server-json.mjs && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9",
    "@types/node": "^22.10.5",
    "eslint": "^9",
    "globals": "^16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8",
    "@changesets/changelog-github": "^0.5.1"
  }
}
